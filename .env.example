# Copy to .env and adjust. Loaded by Node itself (--env-file-if-exists), no dotenv.

PORT=8080

# Database name must be paymentize.
MONGO_URI=mongodb://127.0.0.1:27017/paymentize

# true = no visible windows (required at any real concurrency).
# false = watch each checkout window; only practical for 1-2 sessions.
HEADLESS=true

# Sessions are isolated incognito contexts inside ONE shared Chromium, so each
# costs roughly 100-150MB rather than a whole browser. 25-35 is realistic on an
# 8GB machine. Requests past this get HTTP 503.
MAX_SESSIONS=25

# Close a session with no activity for this long and mark it failed.
# 1200000 = 20 minutes. Drop to ~60000 to test the timeout quickly.
IDLE_TIMEOUT_MS=1200000

# QR lifetime as enforced by Cashfree. The loop regenerates at 90% of this.
QR_TTL_MS=300000
# How often the countdown prints while waiting.
QR_LOG_INTERVAL_MS=30000

# Checkout target. The email/phone typed into its form are picked at random per
# request from static/emails.json and static/numbers.json, not from here.
PAYMENT_PAGE_URL=https://superprofile.bio/vp/parent-control-app-
