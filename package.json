{
    "name": "express-puppeteer",
    "version": "1.0.0",
    "description": "Node.js Express server with Puppeteer integration",
    "main": "server.js",
    "scripts": {
        "start": "node --env-file-if-exists=.env server.js",
        "dev": "nodemon --exec \"node --env-file-if-exists=.env\" server.js"
    },
    "dependencies": {
